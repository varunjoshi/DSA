import java.util.Scanner;
import java.util.Stack;

// Node class
class Node {
    int data;
    Node left, right;

    Node(int data) {
        this.data = data;
        left = right = null;
    }
}

// Binary Tree class
public class BinaryTree {
    Node root;
    Scanner sc = new Scanner(System.in);
    // Insert node as per user's choice
    public void insert() {
        System.out.print("Enter root node value: ");
        int val = sc.nextInt();
        if(root==null)
        {
        root = new Node(val);
        }
        else
        insertNode(root);
    }

    private void insertNode(Node current) {
        System.out.print("Do you want to insert more nodes? (yes/no): ");
        String choice = sc.next();
        if (!choice.equalsIgnoreCase("yes"))
            return;

        System.out.print("Enter value to insert: ");
        int val = sc.nextInt();
        Node newNode = new Node(val);

        while (true) {
            System.out.print("Current Node: " + current.data + ". Insert left or right? ");
            String dir = sc.next();

            if (dir.equalsIgnoreCase("left")) {
                if (current.left == null) {
                    current.left = newNode;
                    break;
                } else {
                    current = current.left;
                }
            } else if (dir.equalsIgnoreCase("right")) {
                if (current.right == null) {
                    current.right = newNode;
                    break;
                } else {
                    current = current.right;
                
            } else {
                System.out.println("Invalid direction! Enter 'left' or 'right'.");
            }
        }

        insertNode(root); // continue inserting
    }

    // Recursive Traversals
    void inorderRec(Node node) {
        if (node != null) {
            inorderRec(node.left);
            System.out.print(node.data + " ");
            inorderRec(node.right);
        }
    }

    void preorderRec(Node node) {
        if (node != null) {
            System.out.print(node.data + " ");
            preorderRec(node.left);
            preorderRec(node.right);
        }
    }

    void postorderRec(Node node) {
        if (node != null) {
            postorderRec(node.left);
            postorderRec(node.right);
            System.out.print(node.data + " ");
        }
    }

    // Non-recursive traversals
    void inorderIter(Node node) {
        Stack<Node> stack = new Stack<>();
        Node current = node;
        while (current != null || !stack.isEmpty()) {
            while (current != null) {
                stack.push(current);
                current = current.left;
            }
            current = stack.pop();
            System.out.print(current.data + " ");
            current = current.right;
        }
    }

    void preorderIter(Node node) {
        if (node == null)
            return;
        Stack<Node> stack = new Stack<>();
        stack.push(node);

        while (!stack.isEmpty()) {
            Node temp = stack.pop();
            System.out.print(temp.data + " ");

            if (temp.right != null)
                stack.push(temp.right);
            if (temp.left != null)
                stack.push(temp.left);
        }
    }

    void postorderIter(Node node) {
        if (node == null)
            return;
        Stack<Node> stack1 = new Stack<>();
        Stack<Node> stack2 = new Stack<>();

        stack1.push(node);
        while (!stack1.isEmpty()) {
            Node temp = stack1.pop();
            stack2.push(temp);

            if (temp.left != null)
                stack1.push(temp.left);
            if (temp.right != null)
                stack1.push(temp.right);
        }

        while (!stack2.isEmpty()) {
            System.out.print(stack2.pop().data + " ");
        }
    }

    // Main method
    public static void main(String[] args) {
        BinaryTree tree = new BinaryTree();
        tree.insert();

        System.out.println("\n--- Recursive Traversals ---");
        System.out.print("Inorder: ");
        tree.inorderRec(tree.root);
        System.out.print("\nPreorder: ");
        tree.preorderRec(tree.root);
        System.out.print("\nPostorder: ");
        tree.postorderRec(tree.root);

        System.out.println("\n\n--- Non-Recursive Traversals ---");
        System.out.print("Inorder: ");
        tree.inorderIter(tree.root);
        System.out.print("\nPreorder: ");
        tree.preorderIter(tree.root);
        System.out.print("\nPostorder: ");
        tree.postorderIter(tree.root);
    }
}
